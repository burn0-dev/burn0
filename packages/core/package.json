{
  "name": "@burn0/core",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": "./dist/register.mjs",
      "require": "./dist/register.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:bun": "bun test tests/bun",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "hono": "^4",
    "tsdown": "^0.22.7",
    "typescript": "^5.7.0",
    "undici": "^7.0.0",
    "unrun": "^0.3.1",
    "vitest": "^3.0.0"
  }
}
